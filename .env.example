# Local development uses the integrated service at port 1234.
# Optional remote service, set before building the frontend:
VITE_CODEFOLIO_SERVICE_URL=
# To use your own deployment:
# VITE_CODEFOLIO_SERVICE_URL=https://your-service.example
# CODEFOLIO_ALLOWED_ORIGINS=https://your-codefolio.example
# Remote assistant access requires a service token:
# CODEFOLIO_AI_TOKEN=choose-a-long-random-token
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# CODEFOLIO_CUSTOM_API_KEY=

# An empty VITE_CODEFOLIO_SERVICE_URL keeps normal workspaces local.
